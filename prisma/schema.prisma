model Order {
  id             Int     @id @default(autoincrement())
  comment        String?
  deliveryStatus String?
  payment        String?
  totalPrice     Float?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  contactDataId  Int?
  contactData    ContactData? @relation(fields: [contactDataId], references: [id])

  products ProductOnOrder[]
}

model DescriptionBlock {
  id          Int      @id @default(autoincrement())
  name        String?
  description String?
  title       String?
  second      String?
  count       Int?
  media       String?
  price       Float?
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id])
}

model MediaDescriptionBlock {
  id          Int      @id @default(autoincrement())
  header      String?
  description String?
  media       String?
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id])
}

model CharacteristicsDescriptionBlock {
  id              Int      @id @default(autoincrement())
  header          String?
  description     String?
  characteristics String?
  media           String?
  productId       Int?
  product         Product? @relation(fields: [productId], references: [id])
}

model ContactData {
  id          Int       @id @default(autoincrement())
  firstName   String
  secondName  String?
  patronymic  String?
  birthDate   DateTime?
  phoneNumber String?
  email       String?

  user   User?
  orders Order[]
}

model ProductOnOrder {
  id    Int @id @default(autoincrement())
  count Int

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

model Product {
  id               Int                               @id @default(autoincrement())
  name             String
  price            Float
  discount         Float
  media            String
  description      String
  count            Int
  categoryId       Int
  category         Category                          @relation(fields: [categoryId], references: [id])
  characteristics  CharacteristicsDescriptionBlock[]
  mediaBlock       MediaDescriptionBlock[]
  descriptionBlock DescriptionBlock[]
  
  popular          Boolean                           @default(false)
  isNew            Boolean                           @default(false)

  orders           ProductOnOrder[]
}

model Delivery {
  id             Int     @id @default(autoincrement())
  area           String
  houseNumber    String
  street         String
  flatNumber     String?
  entranceNumber String?

  users  User[]
}

model Category {
  id      Int       @id @default(autoincrement())
  name    String
  Product Product[]
}

